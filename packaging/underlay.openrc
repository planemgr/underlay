#!/sbin/openrc-run

description="underlay WireGuard mesh"
command=/bin/sh
command_args="-c 'set -a && . /etc/underlay/underlay.conf && exec /usr/bin/underlay'"
supervisor=supervise-daemon
respawn_delay=1
respawn_max=0
output_logger="logger -t underlay -p daemon.info"
error_logger="logger -t underlay -p daemon.err"

depend() {
	need net
	use logger
	after firewall
}
